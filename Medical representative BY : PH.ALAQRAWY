<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Medical Representative By: PH.ALAQRAWY</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            max-width: 1200px;
            margin: 20px auto;
            padding: 20px;
            background-color: #f8f9fa;
        }

        .section {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .color-label {
            display: block;
            padding: 8px;
            border-radius: 5px;
            margin-bottom: 8px;
            font-weight: bold;
        }

        .doctor-label { background: #e3f2fd; color: #1976d2; }
        .location-label { background: #e8f5e9; color: #2e7d32; }
        .class-label { background: #f3e5f5; color: #9c27b0; }
        .item-label { background: #fff3e0; color: #ef6c00; }
        .time-label { background: #f0f4c3; color: #827717; }

        input, select, textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            box-sizing: border-box;
        }

        button {
            padding: 12px 30px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }

        .add-btn {
            background: #4caf50;
            color: white;
        }

        .export-btn {
            background: #2196f3;
            color: white;
            margin-left: 15px;
        }

        .entry-item {
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .header {
            text-align: center;
            margin-bottom: 25px;
        }

        .header h2 {
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .header p {
            color: #666;
            font-size: 0.9em;
        }
    </style>
</head>
<body>
    <div class="section">
        <div class="header">
            <h2>📋 Medical Representative Daily Report</h2>
            <p>By: PH.ALAQRAWY</p>
        </div>
        
        <div class="form-row">
            <div>
                <span class="color-label doctor-label">Doctor Name</span>
                <input type="text" id="doctorName" placeholder="Dr. Full Name">
            </div>
            <div>
                <span class="color-label location-label">Location</span>
                <input type="text" id="location" placeholder="Hospital/Clinic Name">
            </div>
            <div>
                <span class="color-label class-label">Visit Class</span>
                <select id="visitClass">
                    <option value="Class A">Class A</option>
                    <option value="Class B">Class B</option>
                    <option value="Class C">Class C</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div>
                <span class="color-label item-label">Item Name</span>
                <input type="text" id="itemName" placeholder="Product/Material Discussed">
            </div>
            <div>
                <span class="color-label doctor-label">Speciality</span>
                <select id="speciality">
                    <option value="Internal Medicine">Internal Medicine</option>
                    <option value="Cardiology">Cardiology</option>
                    <option value="Endocrinology">Endocrinology</option>
                    <option value="Neurology">Neurology</option>
                    <option value="Oncology">Oncology</option>
                    <option value="Pediatrics">Pediatrics</option>
                </select>
            </div>
            <div>
                <span class="color-label time-label">Visit Date</span>
                <input type="date" id="visitDate">
            </div>
        </div>

        <div class="form-row">
            <div style="grid-column: 1 / -1;">
                <span class="color-label location-label">Notes</span>
                <textarea id="notes" rows="4" placeholder="Detailed discussion notes..."></textarea>
            </div>
        </div>

        <div class="form-row">
            <div>
                <span class="color-label item-label">Actions</span>
                <div style="margin-top: 10px;">
                    <label><input type="checkbox" id="prescribing"> Prescribing</label>
                    <label style="margin-left: 15px;"><input type="checkbox" id="testing"> Testing</label>
                </div>
            </div>
        </div>

        <div style="margin-top: 25px;">
            <button class="add-btn" onclick="addEntry()">➕ Add Entry</button>
            <button class="export-btn" onclick="exportExcel()">📊 Export Excel</button>
            <button class="export-btn" onclick="exportPDF()">📄 Export PDF</button>
        </div>

        <div id="entriesList" class="list-container" style="margin-top: 30px;"></div>
    </div>

    <script>
        let entries = [];

        function addEntry() {
            const timestamp = new Date().toLocaleString();
            const entry = {
                doctor: document.getElementById('doctorName').value.trim(),
                location: document.getElementById('location').value.trim(),
                visitClass: document.getElementById('visitClass').value,
                item: document.getElementById('itemName').value.trim(),
                speciality: document.getElementById('speciality').value,
                date: document.getElementById('visitDate').value,
                notes: document.getElementById('notes').value.trim(),
                prescribing: document.getElementById('prescribing').checked,
                testing: document.getElementById('testing').checked,
                timestamp: timestamp // Non-changeable time
            };

            if(entry.doctor && entry.location) {
                entries.push(entry);
                updateEntriesList();
                clearForm();
            }
        }

        function updateEntriesList() {
            const list = document.getElementById('entriesList');
            list.innerHTML = entries.map((entry, index) => `
                <div class="entry-item">
                    <div style="color: #1976d2; font-size: 1.1em;">
                        🩺 Dr. ${entry.doctor} (${entry.speciality})
                    </div>
                    <div style="color: #2e7d32; margin: 10px 0;">
                        📍 ${entry.location} | 📅 ${entry.date}
                    </div>
                    <div style="color: #9c27b0;">
                        🏷️ Class: ${entry.visitClass} | 📦 Item: ${entry.item}
                    </div>
                    <div style="color: #ef6c00; margin: 10px 0;">
                        ${entry.prescribing ? '✅ Prescribing' : '❌ No Prescription'} | 
                        ${entry.testing ? '✅ Testing' : '❌ No Testing'}
                    </div>
                    <div style="color: #666;">
                        📝 Notes: ${entry.notes}
                    </div>
                    <div style="color: #827717; font-size: 0.9em; margin-top: 10px;">
                        ⏱️ Entry Time: ${entry.timestamp}
                    </div>
                </div>
            `).join('');
        }

        function clearForm() {
            document.getElementById('doctorName').value = '';
            document.getElementById('location').value = '';
            document.getElementById('itemName').value = '';
            document.getElementById('notes').value = '';
            document.getElementById('prescribing').checked = false;
            document.getElementById('testing').checked = false;
        }

        function exportExcel() {
            if(entries.length === 0) return alert("No data to export!");
            
            const worksheet = XLSX.utils.json_to_sheet(entries.map(e => ({
                "Doctor Name": e.doctor,
                "Speciality": e.speciality,
                "Location": e.location,
                "Visit Class": e.visitClass,
                "Item Discussed": e.item,
                "Visit Date": e.date,
                "Notes": e.notes,
                "Prescribing": e.prescribing ? "Yes" : "No",
                "Testing": e.testing ? "Yes" : "No",
                "Entry Time": e.timestamp
            })));

            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, "Entries");
            XLSX.writeFile(workbook, 'Medical_Report.xlsx');
        }

        function exportPDF() {
            if(entries.length === 0) return alert("No data to export!");
            
            const doc = new jspdf.jsPDF({
                orientation: 'portrait',
                unit: 'mm',
                format: 'a4'
            });

            let yPos = 20;
            doc.setFontSize(18);
            doc.setTextColor(40, 53, 147);
            doc.text("Medical Visit Report", 20, yPos);
            doc.setFontSize(12);
            doc.setTextColor(102, 102, 102);
            doc.text("By: PH.ALAQRAWY", 20, yPos + 7);

            entries.forEach((entry, index) => {
                yPos += 20;
                if(yPos > 280) {
                    doc.addPage();
                    yPos = 20;
                }

                // Doctor Info
                doc.setFontSize(12);
                doc.setTextColor(25, 118, 210);
                doc.text(`Doctor: ${entry.doctor} (${entry.speciality})`, 20, yPos);

                // Location and Date
                doc.setTextColor(46, 125, 50);
                doc.text(`Location: ${entry.location} | Date: ${entry.date}`, 20, yPos + 7);

                // Class and Item
                doc.setTextColor(156, 39, 176);
                doc.text(`Class: ${entry.visitClass} | Item: ${entry.item}`, 20, yPos + 14);

                // Actions
                doc.setTextColor(239, 108, 0);
                doc.text(`Prescribing: ${entry.prescribing ? 'Yes' : 'No'} | Testing: ${entry.testing ? 'Yes' : 'No'}`, 20, yPos + 21);

                // Notes
                doc.setTextColor(102, 102, 102);
                doc.text(`Notes: ${entry.notes}`, 20, yPos + 28);

                // Timestamp
                doc.setTextColor(130, 119, 23);
                doc.text(`Recorded at: ${entry.timestamp}`, 20, yPos + 35);

                yPos += 45;
            });

            doc.save('Medical_Report.pdf');
        }
    </script>
</body>
</html>
